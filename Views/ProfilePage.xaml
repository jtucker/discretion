<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Discretion.ViewModels"
             x:Class="Discretion.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Your Details">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32">
            <Label Text="DISCLOSING PARTY" Style="{StaticResource Overline}" />
            <Label Text="Your Details" Style="{StaticResource Title}" />
            <Label Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,8"
                   Text="These particulars identify you as the Disclosing Party on every agreement you create." />

            <Label Text="Full legal name" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputFrame}">
                <Entry Text="{Binding Name}" Placeholder="e.g. Jonathan Q. Whitmore III" />
            </Border>
            <Label Text="Email address" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputFrame}">
                <Entry Text="{Binding Email}" Placeholder="name@example.com" Keyboard="Email" />
            </Border>
            <Label Text="Phone" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputFrame}">
                <Entry Text="{Binding Phone}" Placeholder="(555) 555-0100" Keyboard="Telephone" />
            </Border>
            <Label Text="Street address" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputFrame}">
                <Entry Text="{Binding Street}" Placeholder="123 Main Street" />
            </Border>
            <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10">
                <VerticalStackLayout>
                    <Label Text="City" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputFrame}">
                        <Entry Text="{Binding City}" Placeholder="City" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="State" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputFrame}">
                        <Entry Text="{Binding Region}" Placeholder="NY" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2">
                    <Label Text="ZIP" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputFrame}">
                        <Entry Text="{Binding PostalCode}" Placeholder="10001" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13" Margin="0,12,0,0"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
            <Button Text="{Binding SaveText}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,20,0,0" />

            <BoxView Style="{StaticResource Divider}" Margin="0,32,0,12" />
            <Label Style="{StaticResource Caption}" FontSize="11" HorizontalTextAlignment="Center"
                   Text="Discretion is provided for entertainment purposes only. Documents generated by this app do not constitute legal advice, and their enforceability should not be relied upon." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
