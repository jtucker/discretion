<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Discretion.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Discretion.Views"
       Title="Discretion"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Parchment}"
       Shell.ForegroundColor="{StaticResource Ink}"
       Shell.TitleColor="{StaticResource Ink}">

    <ShellContent Title="Discretion"
                  ContentTemplate="{DataTemplate views:DashboardPage}"
                  Route="dashboard" />
</Shell>
